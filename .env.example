# Настройки акции «Купи и выиграй с Атемарской».
# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# ── Основное ─────────────────────────────────────────────────────────────────
# DEBUG=True переключает проект на SQLite, локальный Redis и мок ФНС —
# полноценный стенд без внешних интеграций.
DEBUG=True
SECRET_KEY=

# Дополнительные хосты и origin'ы через запятую (домены акции уже зашиты).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

SITE_URL=https://af.cheqly.ru
LANDING_URL=https://af-promo.ru
SUPPORT_EMAIL=af@cheqly.ru

# Идёт ли акция. False — личный кабинет доступен только администраторам.
ACTION_STARTED=True
# Тестовые победители на лендинге, пока нет настоящих. Только для вёрстки.
MOCK_WINNERS=False

# ── Сроки акции ──────────────────────────────────────────────────────────────
# Используются командой seed_promo_calendar и как нижняя граница даты чека.
# Календарь акции живёт в БД (promotion.Raffle) — эти значения только стартовые.
PROMO_START_DATE=2026-10-01
PROMO_END_DATE=2027-01-10
# Первый недельный период длиннее календарной недели: старт 01.10 (четверг),
# первый розыгрыш 14.10 (среда) — значит период 1 закрывается 11.10.
PROMO_FIRST_WEEK_END_DATE=2026-10-11
# День недели еженедельного розыгрыша: 0 — понедельник, 2 — среда.
PROMO_DRAW_WEEKDAY=2
PROMO_MAIN_DRAW_DATE=2027-01-13

# Минимальная сумма акционных товаров в чеке, ₽. По брифу ограничения нет.
PROMO_MIN_SUM_RUB=0

# ── База данных (боевой режим, DEBUG=False) ──────────────────────────────────
POSTGRES_DB=atemar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Моментальные призы («лоток яиц») ─────────────────────────────────────────
# Значения по умолчанию для первого запуска. Дальше их правит менеджер в
# админке (Моментальные призы · Настройки) — БД главнее этих переменных.
INSTANT_EGGS_PER_TRAY=10
INSTANT_ATTEMPTS_PER_RECEIPT=1
INSTANT_DAY_START_HOUR=8
INSTANT_DAY_END_HOUR=23
# 0 — непойманный призовой момент не сгорает никогда.
INSTANT_MOMENT_TTL_HOURS=0

# ── Проверка чеков ───────────────────────────────────────────────────────────
# FNS_DISABLED=True — вместо запроса в ФНС берётся тестовый ответ из
# promotion/debug_config.py. По умолчанию включено при DEBUG=True.
FNS_DISABLED=

# OpenRouter: разбор чека нейросетью. Пустой ключ — штатный выключатель:
# чеки без совпадения по ключевым словам просто уходят на ручную модерацию.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-flash
OPENROUTER_TIMEOUT=30
# Теневой режим: нейросеть смотрит чеки, но ни на что не влияет.
OPENROUTER_SHADOW_MODE=True

# ── OkiDoki: договоры с победителями ─────────────────────────────────────────
# callback_url вшивается в каждый договор при создании и потом не меняется,
# поэтому он обязан указывать на боевой домен именно этой акции.
OKI_DOKI_API_KEY=
OKI_DOKI_CALLBACK_URL=https://af.cheqly.ru/oki-doki/callback/

# ── Уведомления в Telegram (forward-signal) ──────────────────────────────────
# Напоминания о розыгрышах и все ошибки уровня ERROR.
FORWARD_SIGNAL_URL=https://forward-signal.ru/api/send/
NOTIFY_API_TIMEOUT=30
NOTIFY_MAX_RETRIES=3
NOTIFY_RETRY_DELAY=10

# ── DaData: подсказки адресов и банков в профиле участника ───────────────────
DADATA_API_KEY=

# ── Точка Банк, Cyclops: денежные выплаты ────────────────────────────────────
# В брифе этой акции денежных призов нет — подсистема перенесена целиком и
# остаётся выключенной, пока не заполнены реквизиты и не включён флаг ниже.
CYCLOPS_BASE_URL=https://pre.tochka.com/api/v1/cyclops
CYCLOPS_PLATFORM_ID=
CYCLOPS_CERT_THUMBPRINT=
CYCLOPS_PRIVATE_KEY_PATH=/app/keys/private_key.pem
CYCLOPS_USE_TEST_KEY=True
CYCLOPS_NOMINAL_ACCOUNT=
CYCLOPS_PRIZE_AMOUNT=50
CYCLOPS_PRIZE_PURPOSE=Денежный приз, без НДС
CYCLOPS_MAX_PAYOUT_RETRIES=2
CYCLOPS_PAYOUT_THROTTLE_SECONDS=5
CYCLOPS_BLOCKED_BANK_BIKS=
# Плановые пакетные выплаты. Включать осознанно, после контрольной выплаты.
CYCLOPS_SCHEDULED_PAYOUTS_ENABLED=False

# ── Счётчики и подтверждение прав ────────────────────────────────────────────
# Пустые значения — счётчик и мета-тег на страницы не попадают.
YANDEX_METRIKA_ID=
YANDEX_VERIFICATION=
